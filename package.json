    "evaluate": "tsx scripts/evaluate-encounters.ts",
    "evaluate:coop": "tsx scripts/evaluate-coop.ts",
    "measure:pursuit": "tsx scripts/measure-pursuit.ts",
    "evaluate:run": "tsx scripts/evaluate-run.ts",
    "art:package": "node scripts/art/package.mjs",
    "art:build": "node scripts/art/build.mjs",
    "art:captures": "node scripts/art/captures.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@trystero-p2p/ws-relay": "^0.25.4",
    "three": "^0.186.0",
    "trystero": "^0.25.4"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "4.130.0"
