{
  "name": "ruinweavers-magic-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "deploy:check": "wrangler deploy --dry-run",
    "preview": "vite preview --host 127.0.0.1",
