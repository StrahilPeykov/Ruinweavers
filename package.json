{
  "name": "ruinweavers-magic-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "deploy:check": "wrangler deploy --dry-run",
